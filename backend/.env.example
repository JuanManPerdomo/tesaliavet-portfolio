# Copiar este archivo a .env y completar con valores reales/propios.
# Nunca commitear el .env real.

FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_SECRET_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/tesaliavet_db
FRONTEND_URL=http://localhost:5173

# Correo (opcional) — sin estos valores, el código de recuperación de
# contraseña y los correos transaccionales se loguean en consola en vez
# de enviarse de verdad.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Datos de pago para el checkout (opcional) — sin estos valores, esa
# opción del checkout muestra "Próximamente" en vez de datos falsos.
BANK_ACCOUNT_HOLDER=
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BREB_KEY=
BREB_BANK=
